{
  "name": "aegis-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:audit": "npm run security:secrets && npm audit --audit-level=moderate",
    "verify": "npm run lint && npm run typecheck && npm test && npm run security:audit && npm run build",
    "audit:prod": "npm audit --omit=dev",
    "seed:supabase": "node --env-file=.env.local scripts/seed-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.9",
    "playwright-core": "1.61.1",
    "typescript": "^5.9.0",
    "vitest": "4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
