APP_NAME=Aegis-Monitor

# Optional: enable real Vercel deployment history in /api/monitoring.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional: enable Supabase-backed service metrics and logs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public anon values can be used for read-only demo tables if row-level security is configured safely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: require API key auth for monitoring routes.
MONITORING_API_KEY=
MONITORING_REQUIRE_API_KEY=false

# Optional: use a Redis-compatible REST cache, such as Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
